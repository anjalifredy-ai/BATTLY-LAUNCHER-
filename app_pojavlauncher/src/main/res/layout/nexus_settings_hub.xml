<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexus_bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/nexus_settings_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/nexus_text_primary"
                android:textSize="18sp"
                android:background="@drawable/nexus_nav_icon_bg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETTINGS"
                    android:textColor="@color/nexus_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customize Nexus Launcher PRO to match your style"
                    android:textColor="@color/nexus_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/nexus_set_java"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/nexus_card_elevated_bg"
                android:padding="14dp"
                android:layout_marginEnd="6dp">

                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:gravity="center" android:text="☕" android:textSize="18sp"
                    android:background="@drawable/nexus_nav_icon_bg" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="Java Tweaks"
                    android:textColor="@color/nexus_text_primary" android:textStyle="bold" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Java Runtimes, JVM, RAM"
                    android:textColor="@color/nexus_text_secondary" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nexus_set_misc"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/nexus_card_elevated_bg"
                android:padding="14dp"
                android:layout_marginStart="6dp">

                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:gravity="center" android:text="⬡" android:textSize="16sp"
                    android:background="@drawable/nexus_nav_icon_bg" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="Miscellaneous"
                    android:textColor="@color/nexus_text_primary" android:textStyle="bold" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Version list and libraries"
                    android:textColor="@color/nexus_text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/nexus_set_video"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/nexus_card_elevated_bg"
                android:padding="14dp"
                android:layout_marginEnd="6dp">

                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:gravity="center" android:text="▣" android:textSize="16sp"
                    android:background="@drawable/nexus_nav_icon_bg" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="Video and renderer"
                    android:textColor="@color/nexus_text_primary" android:textStyle="bold" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Resolution, renderer, performance"
                    android:textColor="@color/nexus_text_secondary" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nexus_set_experimental"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/nexus_card_elevated_bg"
                android:padding="14dp"
                android:layout_marginStart="6dp">

                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:gravity="center" android:text="⚗" android:textSize="16sp"
                    android:background="@drawable/nexus_nav_icon_bg" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="Experimental"
                    android:textColor="@color/nexus_text_primary" android:textStyle="bold" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Use with consideration"
                    android:textColor="@color/nexus_text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
