<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E60B0F1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/nexus_card_elevated_bg"
        android:padding="16dp"
        android:layout_margin="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nexus_create_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/nexus_text_primary"
                android:background="@drawable/nexus_nav_icon_bg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Create Instance"
                    android:textColor="@color/nexus_text_primary" android:textStyle="bold" android:textSize="16sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Normal profile · choose loader"
                    android:textColor="@color/nexus_text_secondary" android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/nexus_create_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/nexus_text_secondary" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="NAME"
            android:textColor="@color/nexus_text_muted" android:textSize="10sp" android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/nexus_create_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/nexus_card_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="Fabric 1.21"
            android:textColorHint="@color/nexus_text_muted"
            android:textColor="@color/nexus_text_primary"
            android:textSize="14sp"
            android:inputType="text"
            android:singleLine="true" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="LOADER"
            android:textColor="@color/nexus_text_muted" android:textSize="10sp" android:letterSpacing="0.08" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/nexus_loader_vanilla" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:gravity="center" android:paddingLeft="14dp" android:paddingRight="14dp"
                    android:text="Vanilla" android:textColor="@color/nexus_text_primary"
                    android:background="@drawable/nexus_card_bg" android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/nexus_loader_fabric" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:gravity="center" android:paddingLeft="14dp" android:paddingRight="14dp"
                    android:text="Fabric" android:textColor="@color/nexus_play_text" android:textStyle="bold"
                    android:background="@drawable/nexus_play_button_bg" android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/nexus_loader_forge" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:gravity="center" android:paddingLeft="14dp" android:paddingRight="14dp"
                    android:text="Forge" android:textColor="@color/nexus_text_primary"
                    android:background="@drawable/nexus_card_bg" android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/nexus_loader_quilt" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:gravity="center" android:paddingLeft="14dp" android:paddingRight="14dp"
                    android:text="Quilt" android:textColor="@color/nexus_text_primary"
                    android:background="@drawable/nexus_card_bg" android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/nexus_loader_optifine" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:gravity="center" android:paddingLeft="14dp" android:paddingRight="14dp"
                    android:text="OptiFine" android:textColor="@color/nexus_text_primary"
                    android:background="@drawable/nexus_card_bg" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nexus_create_cancel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="Cancel"
                android:textColor="@color/nexus_text_secondary"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:background="@drawable/nexus_card_bg"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/nexus_create_confirm"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="+ Create"
                android:textColor="@color/nexus_play_text"
                android:textStyle="bold"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:background="@drawable/nexus_play_button_bg" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
