<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/nexus_card_bg"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nexus_server_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/nexus_text_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:text="Server" />

        <TextView
            android:id="@+id/nexus_server_row_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="12sp"
            android:text="play.example.com" />
    </LinearLayout>

    <TextView
        android:id="@+id/nexus_server_row_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete"
        android:textColor="#FF6B6B"
        android:padding="8dp"
        android:textSize="12sp" />
</LinearLayout>
