<?xml version="1.0" encoding="utf-8"?>
<!-- Nexus Launcher Home – matches reference screenshot 1/10 structure -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexus_bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/nexus_home_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- ===== TOP BAR ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@color/nexus_nav_bg">

            <TextView
                android:id="@+id/nexus_logo_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXUS LAUNCHER"
                android:textColor="@color/nexus_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  PLAY BEYOND LIMITS"
                android:textColor="@color/nexus_text_muted"
                android:textSize="10sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Nav pills -->
            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="⌂"
                android:textColor="@color/nexus_accent"
                android:textSize="16sp"
                android:background="@drawable/nexus_card_bg"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/nexus_account_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCOUNT ▾"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="12sp"
                android:padding="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⋮"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="18sp"
                android:padding="6dp" />
        </LinearLayout>

        <!-- ===== HERO BANNER ===== -->
        <FrameLayout
            android:id="@+id/nexus_hero_banner"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/nexus_card_elevated_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MINECRAFT"
                    android:textColor="@color/nexus_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAY WITHOUT LIMITS"
                    android:textColor="@color/nexus_text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/nexus_hero_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26.3 • Fabric"
                        android:textColor="@color/nexus_text_secondary"
                        android:textSize="11sp"
                        android:background="@drawable/nexus_card_bg"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FAST"
                        android:textColor="@color/nexus_fast"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STABLE"
                        android:textColor="@color/nexus_stable"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CUSTOMIZABLE"
                        android:textColor="@color/nexus_customizable"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ===== SELECTED PROFILE + PLAY ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/nexus_selected_profile_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:background="@drawable/nexus_card_bg"
                android:padding="12dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECTED PROFILE"
                        android:textColor="@color/nexus_text_muted"
                        android:textSize="9sp"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/nexus_selected_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spunky Optimized"
                        android:textColor="@color/nexus_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/nexus_selected_profile_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26.3 • Fabric"
                        android:textColor="@color/nexus_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="@color/nexus_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/nexus_edit_profile_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDIT"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="14dp" />

            <TextView
                android:id="@+id/nexus_play_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:gravity="center"
                android:text="▶  PLAY"
                android:textColor="@color/nexus_play_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/nexus_play_button_bg"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />
        </LinearLayout>

        <!-- ===== BROWSER RESOURCES + MANAGER ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/nexus_browser_resources_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/nexus_card_bg"
                android:padding="16dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BROWSER RESOURCES"
                    android:textColor="@color/nexus_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mods • Resource Packs • Shader Packs"
                    android:textColor="@color/nexus_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="›"
                    android:textColor="@color/nexus_text_muted"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nexus_manager_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/nexus_card_bg"
                android:padding="16dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MANAGER"
                    android:textColor="@color/nexus_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage Installed Mods, Packs and Worlds"
                    android:textColor="@color/nexus_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="›"
                    android:textColor="@color/nexus_text_muted"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
