<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nexus_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nexus_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/nexus_nav_bg">

        <TextView
            android:id="@+id/nexus_logo_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXUS LAUNCHER"
            android:textColor="@color/nexus_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/nexus_account_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/nexus_hero_banner"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_margin="12dp"
        android:background="@drawable/nexus_card_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="16dp"
            android:text="MINECRAFT\nPLAY WITHOUT LIMITS"
            android:textColor="@color/nexus_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nexus_hero_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="12dp"
            android:text="26.3 • Fabric"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="11sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/nexus_selected_profile_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/nexus_card_bg"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECTED PROFILE"
                android:textColor="@color/nexus_text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/nexus_selected_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spunky Optimized"
                android:textColor="@color/nexus_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nexus_selected_profile_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26.3 • Fabric"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/nexus_edit_profile_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDIT"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="12sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/nexus_play_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶  PLAY"
            android:textColor="@color/nexus_play_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/nexus_play_button_bg"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/nexus_browser_resources_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/nexus_card_bg"
            android:padding="14dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BROWSER RESOURCES"
                android:textColor="@color/nexus_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mods • Resource Packs • Shader Packs"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nexus_manager_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/nexus_card_bg"
            android:padding="14dp"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MANAGER"
                android:textColor="@color/nexus_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage Installed Mods, Packs and Worlds"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
