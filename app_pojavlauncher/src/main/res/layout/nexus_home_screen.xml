<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexus_bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/nexus_home_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- TOP BAR — matches screenshot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@color/nexus_nav_bg">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/nexus_logo"
                android:contentDescription="Logo"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nexus_logo_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEXUS LAUNCHER PRO"
                    android:textColor="@color/nexus_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAY BEYOND LIMITS"
                    android:textColor="@color/nexus_text_muted"
                    android:textSize="8sp"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Nav pills like screenshot -->
            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="⌂"
                android:textColor="@color/nexus_accent"
                android:textSize="16sp"
                android:background="@drawable/nexus_nav_icon_bg"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/nexus_nav_icon_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/nexus_logo"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Account" />

                <TextView
                    android:id="@+id/nexus_account_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCOUNT"
                    android:textColor="@color/nexus_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" ▾"
                    android:textColor="@color/nexus_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="⋮"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="18sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- HERO BANNER with character art -->
        <FrameLayout
            android:id="@+id/nexus_hero_banner"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="10dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/nexus_hero_art"
                android:scaleType="centerCrop"
                android:contentDescription="Hero" />

            <!-- dark gradient overlay for text readability -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#660B0F1A" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                    <TextView
                        android:id="@+id/nexus_hero_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26.3 • Fabric"
                        android:textColor="@color/nexus_text_primary"
                        android:textSize="11sp"
                        android:background="@drawable/nexus_chip_bg"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MINECRAFT"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAY WITHOUT LIMITS"
                    android:textColor="@color/nexus_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="2dp" />

                <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◆ FAST"
                        android:textColor="@color/nexus_fast"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/nexus_chip_bg"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☁ STABLE"
                        android:textColor="@color/nexus_stable"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/nexus_chip_bg"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◇ CUSTOMIZABLE"
                        android:textColor="@color/nexus_customizable"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/nexus_chip_bg"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- PROFILE + EDIT + PLAY row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/nexus_selected_profile_card"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:background="@drawable/nexus_card_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/nexus_fabric_badge"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/nexus_fabric_badge"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Loader" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECTED PROFILE"
                        android:textColor="@color/nexus_text_muted"
                        android:textSize="9sp"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/nexus_selected_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spunky Optimized"
                        android:textColor="@color/nexus_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1dp" />

                    <TextView
                        android:id="@+id/nexus_selected_profile_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26.3 • Fabric"
                        android:textColor="@color/nexus_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▾"
                    android:textColor="@color/nexus_text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/nexus_edit_profile_btn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="⬡  EDIT"
                android:textColor="@color/nexus_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/nexus_edit_btn_bg"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_marginStart="8dp" />

            <LinearLayout
                android:id="@+id/nexus_play_button"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:minWidth="150dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/nexus_play_button_bg"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textColor="@color/nexus_play_text"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PLAY"
                        android:textColor="@color/nexus_play_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/nexus_play_version_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26.3 • Fabric"
                        android:textColor="#CCFFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- BROWSER RESOURCES + MANAGER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp">

            <FrameLayout
                android:id="@+id/nexus_browser_resources_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/nexus_card_elevated_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:text="⬡"
                            android:textColor="@color/nexus_accent"
                            android:textSize="16sp"
                            android:background="@drawable/nexus_nav_icon_bg"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="BROWSER RESOURCES"
                            android:textColor="@color/nexus_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/nexus_text_muted"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Mods • Resource Packs • Shader Packs"
                        android:textColor="@color/nexus_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nexus_manager_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/nexus_card_elevated_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:text="☰"
                            android:textColor="@color/nexus_accent"
                            android:textSize="14sp"
                            android:background="@drawable/nexus_nav_icon_bg"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="MANAGER"
                            android:textColor="@color/nexus_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/nexus_text_muted"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Manage Installed Mods, Packs and Worlds"
                        android:textColor="@color/nexus_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- MULTIPLAYER row kept under home -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:text="MULTIPLAYER"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="10sp"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:id="@+id/nexus_servers_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/nexus_card_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SERVERS"
                    android:textColor="@color/nexus_text_primary"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Saved IPs · free hosting"
                    android:textColor="@color/nexus_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/nexus_home_aternos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="ATERNOS"
                android:textColor="@color/nexus_accent"
                android:textStyle="bold"
                android:textSize="11sp"
                android:background="@drawable/nexus_nav_icon_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/nexus_home_minehut"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="MINEHUT"
                android:textColor="@color/nexus_accent"
                android:textStyle="bold"
                android:textSize="11sp"
                android:background="@drawable/nexus_nav_icon_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
