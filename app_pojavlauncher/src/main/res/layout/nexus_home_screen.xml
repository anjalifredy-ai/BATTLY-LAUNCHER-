<?xml version="1.0" encoding="utf-8"?>
<!--
  Nexus Launcher - Home Screen (matches reference screenshot 1/10)
  Dark navy + blue glass theme
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nexus_bg_primary">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/nexus_nav_bg">

        <!-- Logo + Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXUS LAUNCHER"
            android:textColor="@color/nexus_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Nav icons placeholder row -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:src="@android:drawable/ic_menu_compass"
            android:tint="@color/nexus_nav_icon_active" />

        <!-- Account -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_more"
            android:tint="@color/nexus_nav_icon" />
    </LinearLayout>

    <!-- Hero Banner -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_margin="12dp"
        android:background="@drawable/nexus_card_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="16dp"
            android:text="MINECRAFT\nPLAY WITHOUT LIMITS"
            android:textColor="@color/nexus_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Version + tags -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26.3 • Fabric"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAST"
                android:textColor="@color/nexus_fast"
                android:textSize="10sp"
                android:layout_marginEnd="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STABLE"
                android:textColor="@color/nexus_stable"
                android:textSize="10sp"
                android:layout_marginEnd="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUSTOMIZABLE"
                android:textColor="@color/nexus_customizable"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Selected Profile + Play row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <!-- Selected Profile card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/nexus_card_bg"
            android:padding="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECTED PROFILE\nSpunky Optimized\n26.3 • Fabric"
                android:textColor="@color/nexus_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDIT"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="12sp"
            android:padding="10dp" />

        <!-- PLAY button -->
        <TextView
            android:id="@+id/nexus_play_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶  PLAY"
            android:textColor="@color/nexus_play_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/nexus_play_button_bg"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
    </LinearLayout>

    <!-- Browser Resources + Manager cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/nexus_card_bg"
            android:padding="14dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BROWSER RESOURCES"
                android:textColor="@color/nexus_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mods • Resource Packs • Shader Packs"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/nexus_card_bg"
            android:padding="14dp"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MANAGER"
                android:textColor="@color/nexus_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage Installed Mods, Packs and Worlds"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
