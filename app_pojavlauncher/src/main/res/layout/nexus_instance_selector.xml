<?xml version="1.0" encoding="utf-8"?>
<!--
  Nexus Launcher - Instance / Profile Selector (matches reference screenshot 2/10)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/nexus_bg_primary"
    android:padding="12dp">

    <!-- Left panel - Profiles summary -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.9"
        android:orientation="vertical"
        android:background="@drawable/nexus_card_bg"
        android:padding="14dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROFILES"
            android:textColor="@color/nexus_text_muted"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Profile"
            android:textColor="@color/nexus_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 instances"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CURRENT"
            android:textColor="@color/nexus_text_muted"
            android:textSize="11sp"
            android:layout_marginTop="20dp" />

        <!-- Current instance card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/nexus_card_elevated_bg"
            android:padding="10dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Spunky Optimized\n26.3 • Fabric"
                android:textColor="@color/nexus_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Create New Instance button -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+  Create New Instance"
            android:textColor="@color/nexus_bg_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/nexus_play_button_bg"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- Right panel - All Instances -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.4"
        android:orientation="vertical"
        android:background="@drawable/nexus_card_bg"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="All Instances"
                android:textColor="@color/nexus_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Instance item 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/nexus_card_elevated_bg"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fabulously Optimized\n26.3 • Fabric"
                android:textColor="@color/nexus_text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✎"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Instance item 2 - ACTIVE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/nexus_card_elevated_bg"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Spunky Optimized\n26.3 • Fabric"
                android:textColor="@color/nexus_text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ ACTIVE"
                android:textColor="@color/nexus_active"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/nexus_active_badge_bg"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✎"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
