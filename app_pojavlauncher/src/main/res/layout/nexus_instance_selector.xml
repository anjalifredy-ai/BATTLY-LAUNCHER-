<?xml version="1.0" encoding="utf-8"?>
<!-- Nexus Instance Selector – matches reference screenshot 2/10 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#99000000"
    android:padding="16dp"
    android:gravity="center">

    <!-- LEFT: Profiles summary -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/nexus_card_bg"
        android:padding="16dp"
        android:layout_marginEnd="8dp"
        android:minHeight="280dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROFILES"
            android:textColor="@color/nexus_text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Profile"
            android:textColor="@color/nexus_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/nexus_instance_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 instances"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CURRENT"
            android:textColor="@color/nexus_text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:id="@+id/nexus_current_instance_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/nexus_card_elevated_bg"
            android:padding="12dp"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/nexus_current_instance_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spunky Optimized"
                android:textColor="@color/nexus_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nexus_current_instance_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26.3 • Fabric"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/nexus_create_instance_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+  Create New Instance"
            android:textColor="#0B0F1A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/nexus_play_button_bg"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="18dp" />
    </LinearLayout>

    <!-- RIGHT: All Instances list -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:background="@drawable/nexus_card_bg"
        android:padding="16dp"
        android:minHeight="280dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="All Instances"
                android:textColor="@color/nexus_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nexus_instance_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="16sp"
                android:padding="4dp" />
        </LinearLayout>

        <!-- Instance row 1 -->
        <LinearLayout
            android:id="@+id/nexus_instance_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/nexus_card_elevated_bg"
            android:padding="12dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fabulously Optimized"
                    android:textColor="@color/nexus_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="26.3 • Fabric"
                    android:textColor="@color/nexus_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✎"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Instance row 2 ACTIVE -->
        <LinearLayout
            android:id="@+id/nexus_instance_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/nexus_card_elevated_bg"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spunky Optimized"
                    android:textColor="@color/nexus_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="26.3 • Fabric"
                    android:textColor="@color/nexus_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ ACTIVE"
                android:textColor="@color/nexus_active"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/nexus_active_badge_bg"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✎"
                android:textColor="@color/nexus_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
