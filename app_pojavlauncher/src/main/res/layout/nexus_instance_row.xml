<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/nexus_card_bg"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/nexus_row_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/nexus_fabric_badge"
        android:layout_marginEnd="12dp"
        android:contentDescription="Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nexus_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/nexus_text_primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:text="Profile" />

        <TextView
            android:id="@+id/nexus_row_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="11sp"
            android:text="1.21" />
    </LinearLayout>

    <TextView
        android:id="@+id/nexus_row_active"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓ ACTIVE"
        android:textColor="@color/nexus_active"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="@drawable/nexus_active_badge_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/nexus_row_edit"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="✎"
        android:textColor="@color/nexus_text_secondary"
        android:textSize="14sp"
        android:background="@drawable/nexus_nav_icon_bg" />
</LinearLayout>
